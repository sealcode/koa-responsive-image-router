{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noImplicitAny": true,
		"noImplicitThis": true,
		"strictNullChecks": true,
		"target": "es2020",
		"declaration": true,
		"esModuleInterop": true,
		"lib": ["ES6", "ESNext"],
		"outDir": "lib",
		"checkJs": false,
		"allowJs": true,
		"declarationDir": "@types",
		"resolveJsonModule": true,
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "test/**/*"],
	"files": ["src/types/filru/index.d.ts"],
	"exclude": ["node_modules/**"]
}
